#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"

if ! dotfiles-has-command dotfiles-has-command 2>/dev/null; then
    export PATH="$DOTFILES_DIR/scripts/.local/bin:$PATH"
fi

source "$DOTFILES_DIR/scripts/.local/lib/dotfiles-lib.sh"

echo "🏥 Dotfiles Health Check"
echo

echo "🧰 mise:"
if check_mise_ready; then
    echo "   ✅ mise $(get_mise_version) (needs $MISE_MIN_VERSION or newer)"
fi
echo "   ℹ️  Config modules: $(dotfiles-mise-env)"
echo

echo "📦 Packages:"
echo

if check_bootstrap_packages; then
    echo "   ✅ All installed"
else
    echo "   ❌ Some are missing (run: dotfiles-update)"
fi
echo
if dotfiles-is-wsl; then
    # 1Password runs on Windows: git signs with its op-ssh-sign-wsl (set in
    # config-wsl) and ssh goes through Windows' ssh.exe and its agent.
    echo "🔑 1Password (Windows):"
    sign_program="$(git config --get gpg.ssh.program || true)"
    if [[ -n "$sign_program" ]] && command -v "$sign_program" >/dev/null 2>&1; then
        echo "   ✅ Signing tool: $sign_program"
    else
        echo "   ❌ Signing tool not found: ${sign_program:-gpg.ssh.program not set}"
        echo "      Check the Windows username and 1Password path in configs/git-wsl/.config/git/config-wsl"
    fi
    if dotfiles-has-command ssh-add.exe && ssh-add.exe -l >/dev/null 2>&1; then
        echo "   ✅ Windows SSH agent has keys (ssh-add.exe)"
    else
        echo "   ❌ Windows SSH agent not reachable or has no keys (is 1Password's SSH agent on in Windows?)"
    fi
elif dotfiles-has-1password; then
    echo "🔑 1Password:"
    if check_1password_agent; then
        echo "   ✅ SSH agent socket"
    else
        echo "   ❌ SSH agent socket missing (is 1Password running with its SSH agent on?)"
    fi
else
    echo "🔑 1Password:"
    echo "   ℹ️  Not installed here. Commits are signed through the agent forwarded from the machine you connect from."
fi

echo
echo "🔐 Git:"
if check_git_push_ssh; then
    echo "   ✅ Dotfiles repo pushes over SSH"
else
    echo "   ❌ Dotfiles repo pushes over HTTPS"
fi

echo
echo "📃 Dotfiles:"
check_dotfiles_linked || echo "   💡 To link them, run: dotfiles-update"

echo
echo "🐟 Login shell:"
check_login_shell || echo "   💡 To set it, run: dotfiles-update (then log in again)"

echo
echo "📋 Migrations:"
if check_migrations_applied; then
    echo "   ✅ All applied"
else
    echo "   ⚠️  Pending (run: dotfiles-update)"
fi

echo
echo "💡 To fix issues, run: dotfiles-install"
