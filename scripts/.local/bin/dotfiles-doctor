#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"

if ! dotfiles-has-command dotfiles-has-command 2>/dev/null; then
    export PATH="$DOTFILES_DIR/scripts/.local/bin:$PATH"
fi

source "$DOTFILES_DIR/scripts/.local/lib/dotfiles-lib.sh"

echo "🏥 Dotfiles Health Check"
echo

echo "🧰 mise:"
if check_mise_ready; then
    echo "   ✅ mise $(get_mise_version) (needs $MISE_MIN_VERSION or newer)"
fi
echo "   ℹ️  Config modules: $(dotfiles-mise-env)"
echo

echo "📦 Packages:"
echo

if check_bootstrap_packages; then
    echo "   ✅ All installed"
else
    echo "   ❌ Some are missing (run: dotfiles-update)"
fi
echo
echo "🔑 1Password:"
if dotfiles-is-ssh-session; then
    echo "   ℹ️  SSH session — 1Password not expected on this host"
else
    if check_1password_agent; then
        echo "   ✅ Agent socket"
    else
        echo "   ❌ Agent socket"
    fi

    if check_1password_ssh_sign; then
        echo "   ✅ SSH sign helper"
    else
        echo "   ❌ SSH sign helper"
    fi
fi

echo
echo "🔐 Git:"
if check_git_remote_ssh; then
    echo "   ✅ Remote uses SSH"
else
    echo "   ❌ Remote uses HTTPS"
fi

echo
echo "📃 Dotfiles:"
check_dotfiles_linked || echo "   💡 To link them, run: dotfiles-update"

echo
echo "🐟 Login shell:"
check_login_shell || echo "   💡 To set it, run: dotfiles-update (then log in again)"

echo
echo "📋 Migrations:"
if check_migrations_applied; then
    echo "   ✅ All applied"
else
    echo "   ⚠️  Pending (run: dotfiles-update)"
fi

echo
echo "💡 To fix issues, run: dotfiles-install"
