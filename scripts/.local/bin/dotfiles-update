#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"

if ! dotfiles-has-command dotfiles-has-command 2>/dev/null; then
    export PATH="$DOTFILES_DIR/scripts/.local/bin:$PATH"
fi

cd "$DOTFILES_DIR"

if [[ -z "${DOTFILES_UPDATE_PULLED:-}" ]]; then
    echo "🔄 Updating dotfiles..."

    if git pull --rebase; then
        echo "✅ Git pull successful"
    else
        echo "❌ Git pull failed" >&2
        exit 1
    fi

    # Bash keeps running the copy of this script it started with, so restart
    # with the version just pulled. Changes to the steps below then take
    # effect in the same update that delivers them.
    export DOTFILES_UPDATE_PULLED=1
    exec "$DOTFILES_DIR/scripts/.local/bin/dotfiles-update" "$@"
fi

echo

source "$DOTFILES_DIR/scripts/.local/lib/dotfiles-lib.sh"

# Stop before changing anything if mise can't apply this version's config.
if ! check_mise_ready; then
    echo "❌ Update stopped: the repo is pulled, but nothing else has changed" >&2
    echo "   Fix mise as above, then run: dotfiles-update" >&2
    exit 1
fi

if dotfiles-migrate; then
    echo
else
    echo "❌ Migrations failed" >&2
    echo "   Your dotfiles are updated but migrations didn't complete" >&2
    echo "   Please fix the issue and run: dotfiles-migrate" >&2
    exit 1
fi

echo "📃 Re-syncing dotfile configs..."
echo

# Idempotent: links any new file a package picked up since this host last
# updated, so a config package never needs its own migration just to deliver
# a new file to existing installs.
stow_configs_for_host || echo "   ⚠️  One or more configs failed to stow" >&2

echo
echo "🧰 Applying mise config..."
echo

apply_mise_bootstrap

echo
echo "✅ Dotfiles updated successfully"
