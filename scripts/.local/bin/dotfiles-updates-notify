#!/usr/bin/env bash
set -euo pipefail

CACHE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles-updates-last-check"
TODAY=$(date +%Y-%m-%d)

mkdir -p "$(dirname "$CACHE_FILE")"

if [[ -f "$CACHE_FILE" ]]; then
    LAST_CHECK=$(cat "$CACHE_FILE")
else
    LAST_CHECK=""
fi

if [[ "$LAST_CHECK" != "$TODAY" ]]; then
    # Record the day first, so a failed check (offline, say) doesn't repeat in
    # every new shell. Run dotfiles-check-updates to check again by hand.
    echo "$TODAY" > "$CACHE_FILE"
    dotfiles-check-updates || true
fi
