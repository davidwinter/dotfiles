#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"

cd "$DOTFILES_DIR"

if ! git diff-index --quiet HEAD --; then
    echo "⚠ Uncommitted changes found in dotfiles:"
    git diff-index --name-status HEAD -- | sed 's/^/  /'
fi

UNTRACKED=$(git ls-files --others --exclude-standard)
if [[ -n "$UNTRACKED" ]]; then
    echo "⚠ Untracked files found in dotfiles:"
    echo "$UNTRACKED" | sed 's/^/  /'
fi

# Never prompt for credentials, and give up on a stalled transfer rather than
# hold up the shell that runs this check.
if ! GIT_TERMINAL_PROMPT=0 git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 \
        fetch --quiet origin 2>/dev/null; then
    echo "⚠ Couldn't check for dotfiles updates (offline?)" >&2
    exit 1
fi

if ! git rev-parse --verify --quiet "@{u}" >/dev/null; then
    branch="$(git branch --show-current)"
    echo "⚠ Couldn't check for dotfiles updates: ${branch:-detached HEAD} has no upstream branch" >&2
    exit 1
fi

read -r AHEAD BEHIND < <(git rev-list --left-right --count "HEAD...@{u}")

if (( BEHIND > 0 )); then
    echo "🔔 Dotfiles updates available! ($BEHIND commit(s) behind)"
    echo "   Run: dotfiles-update"
fi

if (( AHEAD > 0 )); then
    echo "⚠ $AHEAD dotfiles commit(s) not pushed yet"
fi
