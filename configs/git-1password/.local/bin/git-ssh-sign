#!/usr/bin/env bash
# Git SSH commit/tag signing dispatcher for machines with 1Password installed.
#
# op-ssh-sign talks to the 1Password app on whatever machine it runs on and
# ignores $SSH_AUTH_SOCK. That is right locally, but when this desktop is
# reached over SSH it pops 1Password on *this* box instead of routing back to
# the machine that forwarded its agent. So: while a forwarded agent is live,
# defer to ssh-keygen (which signs through it, putting the biometric prompt on
# the laptop that holds the key); otherwise sign locally via op-ssh-sign.
#
# Fish keeps ~/.ssh/agent.sock pointing at the latest SSH login's forwarded
# agent, so this works the same in every terminal, including long-lived tmux,
# zellij and herdr ones, and falls back to this machine once you disconnect.
# ~/.ssh/config applies the same rule to ssh itself.
#
# git invokes the program as: -Y sign -n git -f <pubkey> -U <buffer>
# Both backends accept that identical argument shape, so we forward "$@" as-is.
set -euo pipefail

forwarded="$HOME/.ssh/agent.sock"

if SSH_AUTH_SOCK="$forwarded" ssh-add -l >/dev/null 2>&1; then
  export SSH_AUTH_SOCK="$forwarded"
  exec ssh-keygen "$@"
else
  exec /usr/local/bin/op-ssh-sign "$@"
fi
