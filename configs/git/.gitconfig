[user]
  name = David Winter
  email = i@djw.me
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHRx3xQQg/2JYnCvvxSSNsKcvefeCAkPd4QRO3UURjJ4
[gpg]
  format = ssh
[commit]
  gpgsign = true
[tag]
  gpgsign = true
[core]
  editor = vim
[alias]
  st = status
  ci = commit
  br = branch
  co = checkout
  in = log ..@{u}
  out = log @{u}..
[push]
  autoSetupRemote = true
  followtags = true
[pull]
  rebase = true
[rebase]
  autostash = true
[init]
  defaultBranch = main
# The dotfiles repo is cloned and pulled over HTTPS (no key needed) but pushed
# over SSH, so pushes use your 1Password key.
[url "git@github.com:davidwinter/dotfiles"]
  pushInsteadOf = https://github.com/davidwinter/dotfiles
[include]
  path = ~/.config/git/config-1password
[include]
  path = ~/.config/git/config-wsl
