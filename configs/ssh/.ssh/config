# While you're connected over SSH with a forwarded agent (fish keeps
# ~/.ssh/agent.sock pointing at the latest one), use it from every terminal,
# including long-lived tmux, zellij and herdr ones, so prompts go to the
# machine you connected from.
Match host * exec "env SSH_AUTH_SOCK=%d/.ssh/agent.sock ssh-add -l >/dev/null 2>&1"
  IdentityAgent %d/.ssh/agent.sock

# Otherwise use the local 1Password agent, so prompts appear on this machine.
# This deliberately ignores SSH_TTY: a terminal started during an SSH session
# that has since closed should prompt here too.
Host *
  IdentityAgent ~/.1password/agent.sock

Host grubble-1.grubble.org
  ForwardAgent yes

Host woolley-mac-mini
  ForwardAgent yes

Host sevenofnine
  ForwardAgent yes

Host penny
  ForwardAgent yes
